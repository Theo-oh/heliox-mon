{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "types": [],
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["web/js/**/*.js"],
  "exclude": ["web/vendor", "web/sw.js", "node_modules"]
}
